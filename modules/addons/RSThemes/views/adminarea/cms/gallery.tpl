<div class="rsthemes-gallery" data-media-gallery>
    <button type="button" class="btn btn--primary btn--lg btn--icon btn--gallery" data-media-gallery-prev>
        <i class="btn__icon lm lm-left"></i>
    </button>
    <div class="rsthemes-gallery__container">
        <div class="rsthemes-gallery__header">
            <span class="rsthemes-gallery__title" data-media-gallery-title></span>
            <button class="btn btn--sm btn--icon btn--link" data-media-gallery-close><i class="ls ls-close"></i></button>
        </div>
        <div class="rsthemes-gallery__body">
            <img data-media-gallery-img src="" alt="">
        </div>
    </div>
    <button type="button" class="btn btn--primary btn--lg btn--icon btn--gallery" data-media-gallery-next>
        <i class="btn__icon lm lm-right"></i>
    </button>
</div>