{if $itCartiCheckColor eq "aero"}
	<script>
		function loadiCheck() {
		    jQuery('input.icheck').iCheck({
		        checkboxClass: 'icheckbox_flat-aero',
		        radioClass: 'iradio_flat-aero',
		        increaseArea: '20%'
		    });
	        jQuery('input.addon-selector').iCheck({
		        checkboxClass: 'icheckbox_flat-aero',
		        radioClass: 'iradio_flat-aero',
		        increaseArea: '20%'
		    });
			jQuery('input.existing-card').iCheck({
				checkboxClass: 'icheckbox_flat-aero',
				radioClass: 'iradio_flat-aero',
				increaseArea: '20%'
			});
		}
		loadiCheck();
	</script>
